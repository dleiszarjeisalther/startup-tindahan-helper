{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.23.1"
    },
    "production": {
      "autoIncrement": true
    },
    "apk-release": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
