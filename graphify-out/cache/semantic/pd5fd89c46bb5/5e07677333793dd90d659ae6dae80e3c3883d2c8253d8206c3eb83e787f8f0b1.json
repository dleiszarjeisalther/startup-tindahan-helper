{"nodes": [{"id": "pos_problems_and_seasonal_forecast_problem_returns_voids_exchanges", "label": "Problem 1: Returns, Voids & Exchanges Chaos", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 1", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Unlinked returns, void vs refund confusion, and restocking damaged items cause $101B in retail return losses and phantom inventory."}, {"id": "pos_problems_and_seasonal_forecast_problem_inventory_distortion", "label": "Problem 2: Inventory Distortion & Shrinkage", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 2", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Household consumption (sariling gamit/kupit), spoilage, and unverified stock counts cause system stock to drift from physical shelf stock."}, {"id": "pos_problems_and_seasonal_forecast_problem_tingi_unit_conversion", "label": "Problem 3: Tingi Multi-Unit Conversion & Price Drift", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 3", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Selling by piece (tingi), pack, and case with disconnected SKU records causes price mismatches and inaccurate stock deductions."}, {"id": "pos_problems_and_seasonal_forecast_problem_utang_split_tender", "label": "Problem 4: Utang Credit Ledger & Split Payments", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 4", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Paper utang notebooks lose receivables and delay recording the sale date, corrupting both inventory and seasonal demand history."}, {"id": "pos_problems_and_seasonal_forecast_problem_barcode_failures", "label": "Problem 5: Crumpled/Wet Barcodes & Unbarcoded Repacks", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 5", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Foil snack wrappers, wet cold bottles, and repacked goods (ice, sugar, single pens) fail camera barcode scanning."}, {"id": "pos_problems_and_seasonal_forecast_problem_offline_sync_conflicts", "label": "Problem 6: Offline Outages & Multi-Device Sync Overwrites", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 6", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Unreliable barangay connectivity and naive last-write-wins stock syncing overwrite concurrent checkout deductions."}, {"id": "pos_problems_and_seasonal_forecast_solution_return_wizard_disposition_gate", "label": "Solution 1: 5-Step Receipt-Linked Return Wizard & Disposition Gate", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 1 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Mandates original receipt lookup, separates same-day Void from post-sale Refund, and gates restocking by physical condition (Sellable vs Damaged/Bad Order)."}, {"id": "pos_problems_and_seasonal_forecast_solution_atomic_exchange_flow", "label": "Solution 1B: Atomic Product Exchange Workflow", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 1 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Processes return credit and replacement purchase in a single transaction to prevent double-counting revenue and ensure both SKUs update accurately."}, {"id": "pos_problems_and_seasonal_forecast_solution_stock_adjustment_reasons", "label": "Solution 2: Reason-Coded Stock Adjustments & FEFO Expiry Alerts", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 2 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Tracks Restock, Home Use, Expired/Spoiled, and Physical Audit Count reasons alongside batch expiration alerts."}, {"id": "pos_problems_and_seasonal_forecast_solution_base_unit_catalog", "label": "Solution 3: Unified Base-Unit Catalog & Bundle Pricing Schema", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 3 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Anchors inventory in base units (pieces) with conversion multipliers for packs, cases, and multi-buy promo tiers."}, {"id": "pos_problems_and_seasonal_forecast_solution_utang_ledger_split_tender", "label": "Solution 4: Digital Utang Ledger & Multi-Leg Split Tender", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 4 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Records credit sales immediately on the date of purchase for accurate inventory/demand timing while tracking customer balance repayments separately."}, {"id": "pos_problems_and_seasonal_forecast_solution_hybrid_scanner_quick_tap", "label": "Solution 5: Split Camera Scanner + Quick-Tap Tingi Grid & Shortcodes", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 5 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Combines top camera barcode scanning with one-tap unbarcoded item pills and 2-digit keypad shortcodes."}, {"id": "pos_problems_and_seasonal_forecast_solution_offline_event_sourced_ledger", "label": "Solution 6: Offline-First SQLite + Append-Only Stock Delta Sync", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 6 Solution", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Stores local transactions offline and syncs immutable stock delta events (+Restock, -Sale, +Return) instead of overwriting absolute stock counts."}, {"id": "pos_problems_and_seasonal_forecast_feature_c_seasonal_product_forecast", "label": "Feature C: Seasonal Product Forecast", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Identifies products that sell more during specific months, holidays, weather seasons, or school-opening periods by comparing same-month sales across previous years."}, {"id": "pos_problems_and_seasonal_forecast_method_yoy_monthly_seasonal_index", "label": "Method: YoY Same-Month Comparison & Seasonal Index (SI)", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 2", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Computes SI(i,m) = Actual Uncensored Net Monthly Demand / Trailing 12-Month Average across K historical years."}, {"id": "pos_problems_and_seasonal_forecast_horizon_12_month_initial_cycle", "label": "12-Month Horizon: Initial Seasonal Cycle (Tier 1)", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 2", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Around 12 months of store sales history provides an initial full seasonal cycle across all 12 calendar months."}, {"id": "pos_problems_and_seasonal_forecast_horizon_24_month_recurring_evidence", "label": "24+ Month Horizon: Verified Recurring Patterns (Tier 2)", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 2", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "24 months or more provides multi-year Year-over-Year evidence to distinguish true recurring seasonal peaks from one-off bulk anomalies."}, {"id": "pos_problems_and_seasonal_forecast_example_school_supplies_forecast", "label": "Example: School Supplies Before School Year vs Ordinary Months", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 3", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Demonstrates 5x to 12.9x demand surge for Intermediate Pad Paper, Composition Notebooks, and Black Ballpens in pre-school-opening month vs ordinary months."}, {"id": "pos_problems_and_seasonal_forecast_fc_problem_cold_start", "label": "Forecast Problem C1: Cold-Start Store (<12 Months Data)", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C1", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "New stores lack a full 12-month cycle to compute store-specific seasonal indices."}, {"id": "pos_problems_and_seasonal_forecast_fc_solution_hybrid_category_priors", "label": "Forecast Solution C1: 3-Tier Progressive Hybrid Category Priors", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C1", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Uses Philippine Tindahan category seasonal templates under 12m, blends 70/30 at 12-23m, and uses 100% store YoY history at 24m+."}, {"id": "pos_problems_and_seasonal_forecast_fc_problem_stockout_censored_demand", "label": "Forecast Problem C2: Stockout-Censored Peak Demand", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C2", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Running out of stock early during peak season caps recorded sales and causes the forecast to under-order again next year."}, {"id": "pos_problems_and_seasonal_forecast_fc_solution_instock_velocity_imputation", "label": "Forecast Solution C2: In-Stock Availability Demand Imputation", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C2", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Logs Stock=0 duration and scales observed sales by Total Days / In-Stock Days to recover true uncensored peak demand."}, {"id": "pos_problems_and_seasonal_forecast_fc_problem_shifting_school_holiday_dates", "label": "Forecast Problem C3: Shifting School Opening & Movable Holidays", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C3", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "DepEd school opening month shifts and movable holidays (Holy Week) misalign strict calendar-month YoY comparisons."}, {"id": "pos_problems_and_seasonal_forecast_fc_solution_event_window_anchoring", "label": "Forecast Solution C3: Dual Calendar + Event-Window Anchoring", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C3", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Anchors pre-season surge windows (T-21 to T+7 days) to configurable School Opening and Fiesta dates in Store Settings."}, {"id": "pos_problems_and_seasonal_forecast_fc_problem_one_off_bulk_outliers", "label": "Forecast Problem C4: One-Off Bulk Orders & Return Distortion", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C4", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Single bulk orders (wakes, fiestas) or unsubtracted returns/voids create false seasonal spikes in 12-month data."}, {"id": "pos_problems_and_seasonal_forecast_fc_solution_winsorization_net_demand", "label": "Forecast Solution C4: Outlier Winsorization & Net Sales Filtering", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C4", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Subtracts voids/returns before indexing, trims >3-sigma single-receipt outliers, and requires 24-month recurrence confirmation."}, {"id": "pos_problems_and_seasonal_forecast_fc_problem_brand_switching_sku_churn", "label": "Forecast Problem C5: Brand Switching & SKU Proliferation", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C5", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Changing supplier brands of notebooks or pens across years splits SKU sales history."}, {"id": "pos_problems_and_seasonal_forecast_fc_solution_subcategory_rollup", "label": "Forecast Solution C5: Functional Sub-Category Rollup Forecasting", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problem C5", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Computes seasonal indices at the functional product group level (e.g., Notebooks, Pad Paper) before apportioning to active SKUs."}, {"id": "pos_problems_and_seasonal_forecast_fc_problem_lead_time_cash_constraints", "label": "Forecast Problem C6/C7: Late Alerts & Working Capital Limits", "file_type": "concept", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problems C6 & C7", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Small tindahan owners miss supplier restock windows if alerted too late and have limited cash/shelf space."}, {"id": "pos_problems_and_seasonal_forecast_fc_solution_preseason_alerts_budget_ranking", "label": "Forecast Solution C6/C7: 21-Day Lead-Time Alerts & GMROII Budget Ranking", "file_type": "rationale", "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 3 - Section 4 - Problems C6 & C7", "source_url": null, "captured_at": "2026-10-13T12:50:00Z", "author": null, "contributor": null, "rationale": "Triggers restock alerts 2-3 weeks before seasonal peak, dynamically raises Low Stock thresholds, and ranks reorder items within the owner's cash budget."}], "edges": [{"source": "pos_problems_and_seasonal_forecast_solution_return_wizard_disposition_gate", "target": "pos_problems_and_seasonal_forecast_problem_returns_voids_exchanges", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "POS_PROBLEMS_AND_SEASONAL_FORECAST.md", "source_location": "Part 2 - Problem 1", "weight": 1.0}, {"source": "pos_problems_and_seasonal_forecast_solution_atomic_exchange_flow", "target": "pos_problems_and_seasonal_forecast_prob